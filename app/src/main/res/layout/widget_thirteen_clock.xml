<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/clock_face"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:contentDescription="@string/clock_content_description"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/maya_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="1"
        android:text="4 Ajaw + 8 Kumk’u"
        android:textColor="#F3F3F5"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/long_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="13.0.0.0.0"
        android:textColor="#C9C9CF"
        android:textSize="14sp" />

</LinearLayout>
